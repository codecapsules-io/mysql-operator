#!/usr/bin/env bash
# Copyright 2026 Code Capsules
# SPDX-License-Identifier: Apache-2.0
#
# Verify Apache 2.0 license headers in Go sources under pkg/ and cmd/.
set -euo pipefail

OLD_COPYRIGHTS=(
	'Copyright 2018 Pressinfra SRL'
	'Copyright 2019 Pressinfra SRL'
	'Copyright 2020 Pressinfra SRL'
)
NEW_COPYRIGHT='Copyright 2026 Code Capsules'

GO_DIRS=(pkg cmd)
BASE_BRANCH="${LICENSE_CHECK_BASE_BRANCH:-master}"

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

file_header() {
	head -n 25 "$1"
}

is_generated_go() {
	local f=$1
	[[ "$f" == *zz_generated* ]] && return 0
	grep -q 'Code generated by' "$f" 2>/dev/null
}

file_has_old_copyright() {
	local f=$1
	local old
	for old in "${OLD_COPYRIGHTS[@]}"; do
		if file_header "$f" | grep -Fq "$old"; then
			return 0
		fi
	done
	return 1
}

collect_changed_files() {
	local base=$1
	{
		git diff --name-only "${base}...HEAD" 2>/dev/null || true
		git diff --name-only "${base}" 2>/dev/null || true
		git diff --name-only --cached "${base}" 2>/dev/null || true
		git ls-files --others --exclude-standard
	} | sort -u
}

collect_added_go_files() {
	local base=$1
	local f status
	declare -A seen=()

	while IFS=$'\t' read -r status f; do
		[[ -z "${f:-}" ]] && continue
		[[ "$f" == *.go ]] || continue
		case "$status" in
		A*) seen["$f"]=1 ;;
		esac
	done < <(git diff --name-status "${base}...HEAD" 2>/dev/null || true)

	while IFS= read -r f; do
		[[ "$f" == *.go ]] || continue
		seen["$f"]=1
	done < <(git ls-files --others --exclude-standard)

	for f in "${!seen[@]}"; do
		printf '%s\n' "$f"
	done
}

resolve_base_branch() {
	local ref
	for ref in "$BASE_BRANCH" "origin/$BASE_BRANCH" main "origin/main"; do
		if git rev-parse --verify "$ref" >/dev/null 2>&1; then
			printf '%s' "$ref"
			return 0
		fi
	done
	return 1
}

MISSING=()
while IFS= read -r -d '' f; do
	if ! file_header "$f" | grep -q 'Licensed under the Apache License, Version 2.0'; then
		MISSING+=("$f")
	fi
done < <(find "${GO_DIRS[@]}" -name '*.go' -print0)

if [[ -n "${MISSING[0]:-}" ]]; then
	echo "Files missing Apache 2.0 license header:"
	printf '\t%s\n' "${MISSING[@]}"
	exit 1
fi

if ! BASE="$(resolve_base_branch)"; then
	if [[ -n "${CI:-}" ]]; then
		echo "Could not resolve base branch (tried ${BASE_BRANCH}, origin/${BASE_BRANCH}, main, origin/main)." >&2
		echo "Fetch the default branch in CI (e.g. checkout fetch-depth: 0) or set LICENSE_CHECK_BASE_BRANCH." >&2
		exit 1
	fi
	exit 0
fi

declare -A ADDED_GO=()
while IFS= read -r f; do
	ADDED_GO["$f"]=1
done < <(collect_added_go_files "$BASE")

SHORT=()
MISSING_CC=()
WRONG=()
while IFS= read -r f; do
	[[ "$f" == *.go ]] || continue
	[[ -f "$f" ]] || continue
	is_generated_go "$f" && continue

	if ! file_header "$f" | grep -q 'limitations under the License'; then
		SHORT+=("$f")
	fi
	if ! file_header "$f" | grep -Fq "$NEW_COPYRIGHT"; then
		MISSING_CC+=("$f")
	fi
	if [[ -n "${ADDED_GO[$f]+x}" ]] && file_has_old_copyright "$f"; then
		WRONG+=("$f")
	fi
done < <(collect_changed_files "$BASE")

if [[ -n "${SHORT[0]:-}" ]]; then
	echo "Changed Go files with incomplete license header:"
	printf '\t%s\n' "${SHORT[@]}"
	exit 1
fi

if [[ -n "${MISSING_CC[0]:-}" ]]; then
	echo "Changed Go files missing ${NEW_COPYRIGHT}:"
	printf '\t%s\n' "${MISSING_CC[@]}"
	exit 1
fi

if [[ -n "${WRONG[0]:-}" ]]; then
	echo "New Go files must not use legacy Pressinfra copyright lines:"
	printf '\t%s\n' "${WRONG[@]}"
	exit 1
fi

MISSING_SPDX=()
while IFS= read -r f; do
	[[ -f "$f" ]] || continue
	git check-ignore -q "$f" && continue
	case "$f" in
	*.go|go.mod|LICENSE|NOTICE|.gitignore|*/CODEOWNERS) continue ;;
	esac
	if ! file_header "$f" | grep -q 'SPDX-License-Identifier: Apache-2.0'; then
		if ! file_header "$f" | grep -q 'Licensed under the Apache License, Version 2.0'; then
			MISSING_SPDX+=("$f")
		fi
	fi
done < <(collect_changed_files "$BASE")

if [[ -n "${MISSING_SPDX[0]:-}" ]]; then
	echo "Changed non-Go files missing SPDX-License-Identifier or Apache notice:"
	printf '\t%s\n' "${MISSING_SPDX[@]}"
	exit 1
fi

exit 0
